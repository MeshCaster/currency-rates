# Development settings, read when APP_ENV=development (the default). Sections follow
# src/core/configuration/settings.py. Everything here works as-is with `docker compose up -d db mailpit`
# (or scripts/setup-local.sh). Personal values go in .env.local, which is git-ignored and
# overrides this file.

# ---- application
APP_NAME=fastapi-practice-currency-rates
APP_VERSION=0.1.0
DEBUG=false
API_PREFIX=/api/v1
ROOT_PATH=
# DOCS_ENABLED: unset = /swagger on everywhere except production

# ---- logging (LOG__): readable text; DEBUG also shows each provisional refresh and skipped tick
LOG__LEVEL=INFO
LOG__FORMAT=text
LOG__ACCESS_LOG=true

# ---- database (DATABASE__): the Compose service in docker-compose.yaml
DATABASE__URL=postgresql+asyncpg://rates:rates@localhost:5433/rates
DATABASE__ECHO=false
DATABASE__POOL_SIZE=5
DATABASE__MAX_OVERFLOW=10
DATABASE__POOL_TIMEOUT=30
DATABASE__POOL_RECYCLE=1800
DATABASE__POOL_PRE_PING=true

# ---- security (SECURITY__): a development-only key (32+ characters); never deploy it
SECURITY__SECRET_KEY=dev-only-signing-key-not-for-deployment-0123456789
SECURITY__JWT_ALGORITHM=HS256
SECURITY__ACCESS_TOKEN_EXPIRE_MINUTES=15
# SECURITY__JWT_ISSUER=
# SECURITY__JWT_AUDIENCE=
SECURITY__ALLOWED_HOSTS=*

# ---- CORS (CORS__): the React dev servers proxy /api, so this only matters for direct calls
CORS__ALLOW_ORIGINS=http://localhost:5173,http://localhost:5174
CORS__ALLOW_CREDENTIALS=false
CORS__ALLOW_METHODS=*
CORS__ALLOW_HEADERS=*
CORS__MAX_AGE=600

# ---- HTTP client for the rate providers (HTTP_CLIENT__)
HTTP_CLIENT__TIMEOUT=10
HTTP_CLIENT__CONNECT_RETRIES=2
HTTP_CLIENT__MAX_CONNECTIONS=100
HTTP_CLIENT__MAX_KEEPALIVE_CONNECTIONS=20

# ---- tracing (OTEL__): off locally; `console` prints spans if you turn it on
OTEL__ENABLED=false
OTEL__EXPORTER=console
OTEL__SAMPLE_RATIO=1.0
# OTEL__ENDPOINT=
# OTEL__SERVICE_NAME=

# ---- history sync job (HISTORY_SYNC__)
HISTORY_SYNC__ENABLED=true
HISTORY_SYNC__INTERVAL_SECONDS=60
HISTORY_SYNC__MAX_CONCURRENCY=4
HISTORY_SYNC__PER_PROVIDER_CONCURRENCY=2
HISTORY_SYNC__CONFIG_TIMEOUT_SECONDS=120

# ---- price alert job (ALERTS__)
ALERTS__ENABLED=true
ALERTS__INTERVAL_SECONDS=60
ALERTS__SAMPLE_RETENTION_DAYS=31
ALERTS__MAX_CONCURRENCY=4
ALERTS__TIMEOUT_SECONDS=50

# ---- first admin (ADMIN__): created by `uv run poe seed` or when the worker starts.
# A development-only login for the admin app (http://localhost:5174); never deploy it.
# Override it in .env.local if you like.
ADMIN__EMAIL=admin@example.com
ADMIN__PASSWORD=admin-dev-password

# ---- email (SMTP__): Mailpit catches everything; inbox at http://localhost:8025
SMTP__HOST=localhost
SMTP__PORT=1025
SMTP__SECURITY=none
# SMTP__USERNAME=   (Mailpit needs no login)
# SMTP__PASSWORD=
SMTP__FROM_ADDRESS=Currency Rates <rates@localhost>
SMTP__TIMEOUT_SECONDS=30

# ---- subscription email job (NOTIFICATIONS__)
NOTIFICATIONS__ENABLED=true
NOTIFICATIONS__INTERVAL_SECONDS=60
NOTIFICATIONS__CATCH_UP_HOURS=3
NOTIFICATIONS__TIMEOUT_SECONDS=300

# ---- worker process (WORKER__)
WORKER__HEARTBEAT_FILE=/tmp/currency-rates-worker.heartbeat
WORKER__HEARTBEAT_INTERVAL_SECONDS=15
