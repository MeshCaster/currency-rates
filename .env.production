# Production settings, read when APP_ENV=production. Sections follow
# core.configuration.Settings. The app refuses to start until SECURITY__SECRET_KEY is set.
#
# To fill in yourself: every [ ] item. Uncomment the line once you have the value and tick
# the box. Items marked SECRET belong in your deployment's secret store (container env vars,
# Docker/Kubernetes secrets, CI variables), not in this file, because it is committed.
# Values in the real environment override this file.

# ---- application
APP_NAME=fastapi-practice-currency-rates
APP_VERSION=0.1.0
DEBUG=false
API_PREFIX=/api/v1
# [ ] optional: the path prefix if a proxy serves the API under a sub-path, e.g. /rates
ROOT_PATH=
DOCS_ENABLED=false

# ---- logging (LOG__): one JSON object per line, for a log collector
LOG__LEVEL=INFO
LOG__FORMAT=json
LOG__ACCESS_LOG=true

# ---- database (DATABASE__)
# [ ] SECRET: your PostgreSQL 17 + TimescaleDB connection string
# DATABASE__URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/rates
DATABASE__ECHO=false
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=10
DATABASE__POOL_TIMEOUT=30
DATABASE__POOL_RECYCLE=1800
DATABASE__POOL_PRE_PING=true

# ---- security (SECURITY__)
# [ ] SECRET: a random key of 32+ characters; generate one with
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECURITY__SECRET_KEY=
SECURITY__JWT_ALGORITHM=HS256
SECURITY__ACCESS_TOKEN_EXPIRE_MINUTES=15
# [ ] optional: issuer and audience claims, if other services verify these tokens
# SECURITY__JWT_ISSUER=https://rates.example.com
# SECURITY__JWT_AUDIENCE=currency-rates
# [ ] the domain(s) the API is served on; other Host headers are refused (default * accepts any)
# SECURITY__ALLOWED_HOSTS=rates.example.com

# ---- CORS (CORS__): only needed if the web apps are served from another origin than the API
# [ ] optional: the web apps' origins, comma-separated
# CORS__ALLOW_ORIGINS=https://rates.example.com,https://admin.rates.example.com
CORS__ALLOW_CREDENTIALS=false
CORS__ALLOW_METHODS=GET,POST,PATCH,DELETE
CORS__ALLOW_HEADERS=Authorization,Content-Type
CORS__MAX_AGE=600

# ---- HTTP client for the rate providers (HTTP_CLIENT__)
HTTP_CLIENT__TIMEOUT=10
HTTP_CLIENT__CONNECT_RETRIES=2
HTTP_CLIENT__MAX_CONNECTIONS=100
HTTP_CLIENT__MAX_KEEPALIVE_CONNECTIONS=20

# ---- tracing (OTEL__; install with `uv sync --extra otel`)
OTEL__ENABLED=false
OTEL__EXPORTER=otlp
OTEL__SAMPLE_RATIO=1.0
# [ ] optional: your OpenTelemetry collector, then set OTEL__ENABLED=true
# OTEL__ENDPOINT=http://otel-collector:4317
# OTEL__SERVICE_NAME=currency-rates

# ---- history sync job (HISTORY_SYNC__)
HISTORY_SYNC__ENABLED=true
HISTORY_SYNC__INTERVAL_SECONDS=60
HISTORY_SYNC__MAX_CONCURRENCY=4
HISTORY_SYNC__PER_PROVIDER_CONCURRENCY=2
HISTORY_SYNC__CONFIG_TIMEOUT_SECONDS=120

# ---- price alert job (ALERTS__)
ALERTS__ENABLED=true
ALERTS__INTERVAL_SECONDS=60
ALERTS__SAMPLE_RETENTION_DAYS=31
ALERTS__MAX_CONCURRENCY=4
ALERTS__TIMEOUT_SECONDS=50

# ---- first admin (ADMIN__): created on the first worker start; remove both afterwards
# [ ] the admin's email
# ADMIN__EMAIL=admin@example.com
# [ ] SECRET: the admin's password (8+ characters); an existing account's password is never changed
# ADMIN__PASSWORD=

# ---- email (SMTP__): your mail provider; without SMTP__HOST no email is sent
# [ ] SMTP server
# SMTP__HOST=smtp.example.com
# [ ] port and security: 587 + starttls (most providers) or 465 + ssl
SMTP__PORT=587
SMTP__SECURITY=starttls
# [ ] SMTP login
# SMTP__USERNAME=
# [ ] SECRET: SMTP password or API key
# SMTP__PASSWORD=
# [ ] the sender users see, on a domain your provider lets you send from
# SMTP__FROM_ADDRESS=Currency Rates <rates@example.com>
SMTP__TIMEOUT_SECONDS=30

# ---- subscription email job (NOTIFICATIONS__)
NOTIFICATIONS__ENABLED=true
NOTIFICATIONS__INTERVAL_SECONDS=60
NOTIFICATIONS__CATCH_UP_HOURS=3
NOTIFICATIONS__TIMEOUT_SECONDS=300

# ---- worker process (WORKER__): the path the Docker health check reads (see Dockerfile)
WORKER__HEARTBEAT_FILE=/tmp/currency-rates-worker.heartbeat
WORKER__HEARTBEAT_INTERVAL_SECONDS=15
